# Maintainer: Ergün Elvan Bilsel <bilselergun at gmail dot com>

pkgname=python-sangfor-scp
_name=sangfor_scp
pkgver=0.4.4
pkgrel=1
pkgdesc="Python client for the Sangfor Cloud Platform (SCP) Open-API"
arch=('any')
url="https://github.com/erelbi/sangfor-scp"
license=('MIT')
depends=('python' 'python-requests' 'python-urllib3')
optdepends=('python-pycryptodome: token (username/password) authentication')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest' 'python-pycryptodome')
source=("https://files.pythonhosted.org/packages/source/${_name::1}/$_name/$_name-$pkgver.tar.gz")
sha256sums=('a0aab270da8ac4376c3f89e77e7ce8b781be03bb27ab0bf7c0bdf4ab3d38af07')

build() {
  cd "$_name-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_name-$pkgver"
  python -m pytest tests
}

package() {
  cd "$_name-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 man/scp-health.1 "$pkgdir/usr/share/man/man1/scp-health.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md CONTRIBUTING.md SECURITY.md
}
